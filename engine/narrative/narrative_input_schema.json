{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "narrative_input_schema_v1.0",
  "title": "VenueDNA Player Narrative Input",
  "description": "Contract §2 input object. All unavailable data must be explicit null. Consumed by validate_narrative.py and build_narratives.py.",
  "type": "object",
  "required": ["schema_version", "event", "course_dna", "player", "projection", "traits", "badges", "form", "venue_history", "risk_factors", "live_context"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event": {
      "type": "object",
      "required": ["event_id", "event_name", "venue_id", "venue_name", "event_phase", "generated_at_utc", "data_as_of_utc"],
      "additionalProperties": false,
      "properties": {
        "event_id":         { "type": "string", "pattern": "^pga_\\w+_\\d{4}$" },
        "event_name":       { "type": "string", "minLength": 1 },
        "venue_id":         { "type": "string", "minLength": 1 },
        "venue_name":       { "type": "string", "minLength": 1 },
        "event_phase":      { "type": "string", "enum": ["pre_tournament", "live_round", "post_tournament"] },
        "generated_at_utc": { "type": "string", "format": "date-time" },
        "data_as_of_utc":   { "type": "string", "format": "date-time" }
      }
    },
    "course_dna": {
      "type": "object",
      "required": ["identity_summary", "primary_demands", "scoring_opportunities", "primary_failure_modes"],
      "additionalProperties": false,
      "properties": {
        "identity_summary": { "type": "string", "minLength": 1 },
        "primary_demands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["trait_id", "label", "importance", "rank", "reason"],
            "additionalProperties": false,
            "properties": {
              "trait_id":   { "type": "string", "minLength": 1 },
              "label":      { "type": "string", "minLength": 1 },
              "importance": { "type": "number", "minimum": 0, "maximum": 1 },
              "rank":       { "type": "integer", "minimum": 1 },
              "reason":     { "type": "string", "minLength": 1 }
            }
          }
        },
        "scoring_opportunities":   { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "primary_failure_modes":   { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "par":             { "type": ["integer", "null"] },
        "yardage":         { "type": ["integer", "null"] },
        "weather_context": { "type": ["string", "null"] }
      }
    },
    "player": {
      "type": "object",
      "required": ["player_id", "display_name"],
      "additionalProperties": false,
      "properties": {
        "player_id":    { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "country":      { "type": ["string", "null"] },
        "handedness":   { "type": ["string", "null"] }
      }
    },
    "projection": {
      "type": "object",
      "required": ["vts", "vts_rank", "field_size", "tier", "tier_rank", "conviction", "confidence_score", "confidence_label", "neutral_skill", "venue_fit_delta", "venue_history_delta", "penalty_total", "projection_direction", "projection_reason_codes"],
      "additionalProperties": false,
      "properties": {
        "vts":                    { "type": "number", "minimum": 0, "maximum": 100 },
        "vts_rank":               { "type": "integer", "minimum": 1 },
        "field_size":             { "type": "integer", "minimum": 1 },
        "tier":                   { "type": "string", "enum": ["T1", "T2", "T3", "T4", "T5"] },
        "tier_rank":              { "type": "integer", "minimum": 1 },
        "conviction":             { "type": "string", "enum": ["High", "Medium", "Low"] },
        "confidence_score":       { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_label":       { "type": "string", "enum": ["High", "Medium", "Low"] },
        "neutral_skill":          { "type": "number" },
        "venue_fit_delta":        { "type": "number" },
        "venue_history_delta":    { "type": "number" },
        "penalty_total":          { "type": "number" },
        "projection_direction":   { "type": "string", "enum": ["positive", "negative", "neutral"] },
        "projection_reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trait_id", "label", "score", "field_percentile", "venue_importance", "fit_contribution", "direction", "evidence_status"],
        "additionalProperties": false,
        "properties": {
          "trait_id":         { "type": "string", "minLength": 1 },
          "label":            { "type": "string", "minLength": 1 },
          "score":            { "type": "number", "minimum": 0, "maximum": 100 },
          "field_percentile": { "type": "number", "minimum": 0, "maximum": 100 },
          "venue_importance": { "type": "number", "minimum": 0, "maximum": 1 },
          "fit_contribution": { "type": "number" },
          "direction":        { "type": "string", "enum": ["strength", "weakness", "neutral"] },
          "evidence_status":  { "type": "string", "enum": ["validated", "limited", "unavailable"] }
        }
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["badge_id", "label", "qualification_reason", "evidence_trait_ids"],
        "additionalProperties": false,
        "properties": {
          "badge_id":             { "type": "string", "minLength": 1 },
          "label":                { "type": "string", "minLength": 1 },
          "qualification_reason": { "type": "string", "minLength": 1 },
          "evidence_trait_ids":   { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "form": {
      "type": "object",
      "required": ["sample_window", "form_label", "form_direction", "form_evidence", "recent_results"],
      "additionalProperties": false,
      "properties": {
        "sample_window":   { "type": "string", "minLength": 1 },
        "form_label":      { "type": "string", "minLength": 1 },
        "form_direction":  { "type": "string", "enum": ["improving", "steady", "declining", "limited_data"] },
        "form_evidence":   { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "recent_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_name", "finish", "date"],
            "additionalProperties": false,
            "properties": {
              "event_name": { "type": "string", "minLength": 1 },
              "finish":     { "type": "string", "minLength": 1 },
              "date":       { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "venue_history": {
      "type": "object",
      "required": ["starts", "cuts_made", "best_finish", "history_label", "evidence"],
      "additionalProperties": false,
      "properties": {
        "starts":        { "type": "integer", "minimum": 0 },
        "cuts_made":     { "type": "integer", "minimum": 0 },
        "best_finish":   { "type": ["string", "null"] },
        "history_label": { "type": "string", "minLength": 1 },
        "evidence":      { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "label", "severity", "evidence_trait_id", "description"],
        "additionalProperties": false,
        "properties": {
          "risk_id":          { "type": "string", "minLength": 1 },
          "label":            { "type": "string", "minLength": 1 },
          "severity":         { "type": "string", "enum": ["high", "medium", "low"] },
          "evidence_trait_id":{ "type": ["string", "null"] },
          "description":      { "type": "string", "minLength": 1 }
        }
      }
    },
    "live_context": {
      "type": "object",
      "required": ["round", "position", "strokes_gained", "prediction_status", "round_evidence"],
      "additionalProperties": false,
      "properties": {
        "round":              { "type": ["integer", "null"], "minimum": 1, "maximum": 4 },
        "position":           { "type": ["string", "null"] },
        "strokes_gained":     { "type": "array", "items": { "type": "object" } },
        "prediction_status":  { "type": ["string", "null"] },
        "round_evidence":     { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
